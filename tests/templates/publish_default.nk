 addUserKnob {22 rdo_refreshProfile l @refresh-1 t "Refreshes the current node to the latest profile." -STARTLINE T "\nfrom rdo_comp_pipeline.nodes.write import Write\nWrite.fromNode(nuke.thisNode()).refreshNode()\n"}
 addUserKnob {85 rdo_token1 l "" t step +STARTLINE +DISABLED M {lay}}
 addUserKnob {85 rdo_token2 l "" t variant -STARTLINE M {primary}}
 addUserKnob {85 rdo_token3 l "" t name -STARTLINE M {main}}
 addUserKnob {85 rdo_token4 l "" t part -STARTLINE M {defPart}}
 addUserKnob {85 rdo_token5 l token5 -STARTLINE +DISABLED +HIDDEN M {""}}
 addUserKnob {85 rdo_token6 l token6 -STARTLINE +DISABLED +HIDDEN M {""}}
 addUserKnob {26 rdo_templateName l "" +STARTLINE T "<font color=#9a9a9a>lay.primary.main.defPart</font>"}
 addUserKnob {26 interstice1 l " " T " "}
 addUserKnob {26 rdo_version_label l "" +STARTLINE T version}
 addUserKnob {4 rdo_version l "" t "Allows to dynamically set the version to either 'New' or 'Latest'. If a `New`\n version is sent to the farm, it'll automatically switch to `Latest`. If `manual` is checked, this field\n will be disabled." -STARTLINE M {New Latest}}
 addUserKnob {6 rdo_version_manual l manual t "If checked, the version will stay the same, but version up/down will be\n unrestricted.\nIf unchecked, the version (Next/Latest) will be used dynamically during\ntemplate builds and render submissions. Version up/down with the shortcut will be limited to those two \noptions.\n" -STARTLINE}
 addUserKnob {3 rdo_version_manual_number l "" t "The version number to use when the version manual knob is checked" -STARTLINE +HIDDEN}
 rdo_version_manual_number 1
 addUserKnob {52 rdo_version_manual_number_spinbox l "" -STARTLINE +HIDDEN T rdo_comp_pipeline.nodes.write.writeNukleus._widget.SpinboxButtonsKnob(rdo_comp_pipeline.nodes.write.Write.fromNode(nuke.thisNode()))}
 addUserKnob {26 divider1 l "" +STARTLINE}
 addUserKnob {4 rdo_upstream l "upstream plate" +HIDDEN M {}}
 addUserKnob {22 rdo_upstream_refresh l @refresh-1 -STARTLINE +HIDDEN T "import nuke\nfrom rdo_comp_pipeline.nodes.write.writeNukleus._knobs import UpstreamKnobs\nfrom rdo_comp_pipeline.nodes.write import Write\nUpstreamKnobs(Write.fromNode(nuke.thisNode())).updateUpstreamList()"}
 addUserKnob {26 rdo_upstream_publishName l " " -STARTLINE +HIDDEN T "<font color=#9a9a9a> </font>"}
 addUserKnob {4 rdo_upstream_camera l camera +DISABLED +HIDDEN M {}}
 addUserKnob {4 rdo_upstream_camera_version l version -STARTLINE +DISABLED +HIDDEN M {}}
 addUserKnob {1 rdo_upstream_camera_serialize l __camera +DISABLED +HIDDEN}
 addUserKnob {1 rdo_upstream_camera_version_serialize l __version +DISABLED +HIDDEN}
 addUserKnob {6 rdo_lightTexture_maketx l "Make Texture" t "Convert each frame using `maketx`" +HIDDEN +STARTLINE}
 rdo_lightTexture_maketx false
 addUserKnob {26 spaceRemover1 l "" +STARTLINE +HIDDEN T " "}
 addUserKnob {22 rdo_convertToNativeWrite l "Convert to Nuke Write" t "Changes the current WriteNukleus node into a basic Write node." -STARTLINE +DISABLED +HIDDEN}
 addUserKnob {3 chunk_size l "  chunk size" +DISABLED}
 chunk_size 3
 addUserKnob {6 override_chunk_size l override -STARTLINE}
 addUserKnob {26 spaceRemover2 l "" +STARTLINE T " "}
 addUserKnob {6 gpu_only l "GPU Only" t "If checked, the node will only be rendered on GPU" -STARTLINE}
 addUserKnob {26 spaceRemover3 l "" +STARTLINE T " "}
 addUserKnob {22 rdo_render l Render -STARTLINE T "\nfrom rdo_comp_pipeline.writeRdo import _api\n_api.submit(\[nuke.thisNode()])\n"}
 addUserKnob {22 rdo_read l "Create Read" t "Creates a Read node from the Write node" -STARTLINE T "rdo_comp_pipeline.nodes.Write.fromNode(nuke.thisNode()).createReadNode()\n"}
 addUserKnob {26 interstice2 l " " T " "}
 addUserKnob {20 rdo_groupInfos l info n 2}
 addUserKnob {26 rdo_writeVersion l "node vers." t "The version of the node when it was created.\nUsed to know if an update might be available" T "<font color=#9a9a9a>v9.22.2-beta.rdev-34037.1</font>"}
 addUserKnob {26 rdo_publishFlow l flow T plate}
 addUserKnob {26 rdo_publishedFile l "last publish" T " "}
 addUserKnob {20 rdo_groupInfos l "" +STARTLINE n -1}
 addUserKnob {26 rdo_tokenMapping l "" +STARTLINE +HIDDEN T "\{\"rdo_token1\": \"step\", \"rdo_token2\": \"variant\", \"rdo_token3\": \"name\", \"rdo_token4\": \"part\"\}"}
 addUserKnob {26 rdo_profileCache l "profile cache" t "Serialized profiles" +HIDDEN}
