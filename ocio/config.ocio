ocio_profile_version: 2

# The ComfyUI farm's colour config: only the two conversions the farm does.
#
#   EXR (ACEScg) -> 8-bit PNG for ComfyUI:   scene_linear -> color_picking
#   PNG from ComfyUI -> EXR (ACEScg):        color_picking -> scene_linear
#
# They are a Nuke Write and Read set to "default (color_picking)" in Rodeo's published
# show config (reference/config_1_0_v1.ocio, from
# /rdo/shows/bri3/.published/ocioConfig/config_1_0/v1/), where
#   scene_linear = rdo        ACEScg with the shot's white balance
#   color_picking = ACES-look ACES 1.x RRT + Rec.709 output transform, white balance undone
# The white balance is applied and removed again in both directions, so it cancels and is
# left out here. What remains is the ACEScg -> ACES2065-1 matrix and the ACES Rec.709
# output transform's shaper and 3D LUTs, the same three files Nuke uses.
# tests/test_ocio_repo.py checks this against the reference config and against values
# measured in Nuke.

description: |
  ComfyUI farm: ACEScg <-> ACES 1.x Rec.709 output transform (Rodeo ACES-look /
  color_picking), as Nuke's "default (color_picking)" in config_1_0_v1.

search_path: luts
strictparsing: true
luma: [0.2126, 0.7152, 0.0722]

roles:
  default: acescg
  scene_linear: acescg
  linear: acescg            # what WriteNukleus calls "linear"
  color_picking: comfy_png
  data: raw
  aces_interchange: aces2065-1

file_rules:
  - !<Rule> {name: Default, colorspace: default}

displays:
  sRGB-monitor:             # named as in Rodeo's config; it is set to Rec.709 there too
    - !<View> {name: ACES-look, colorspace: comfy_png}

active_displays: [sRGB-monitor]
active_views: [ACES-look]

colorspaces:
  - !<ColorSpace>
    name: aces2065-1
    aliases: [ACES - ACES2065-1]
    family: ACES
    description: ACES2065-1, the reference space
    isdata: false

  - !<ColorSpace>
    name: acescg
    aliases: [rdo, ACEScg, ACES - ACEScg]
    family: ACES
    description: |
      ACEScg, what the farm's EXRs are in (Rodeo's rdo; its white balance cancels in the
      conversions below).
    isdata: false
    to_scene_reference: !<MatrixTransform> {matrix: [0.695452, 0.140679, 0.163869, 0, 0.0447946, 0.859671, 0.0955343, 0, -0.00552588, 0.00402521, 1.0015, 0, 0, 0, 0, 1]}

  - !<ColorSpace>
    name: comfy_png
    aliases: [ACES-look]
    family: Display
    description: |
      The PNGs ComfyUI reads and writes: ACES 1.x RRT + Rec.709 output transform (Rodeo's
      ACES-look, color_picking).
    isdata: false
    from_scene_reference: !<GroupTransform>
      children:
        - !<FileTransform> {src: Log2_48_nits_Shaper_to_linear.spi1d, interpolation: linear, direction: inverse}
        - !<FileTransform> {src: Log2_48_nits_Shaper.RRT.Rec.709.spi3d, interpolation: tetrahedral}
    to_scene_reference: !<GroupTransform>
      children:
        - !<FileTransform> {src: InvRRT.Rec.709.Log2_48_nits_Shaper.spi3d, interpolation: tetrahedral}
        - !<FileTransform> {src: Log2_48_nits_Shaper_to_linear.spi1d, interpolation: linear}

  - !<ColorSpace>
    name: raw
    aliases: [Utility - Raw]
    family: Utility
    description: Data (normal, bump, roughness, ...), never converted
    isdata: true
